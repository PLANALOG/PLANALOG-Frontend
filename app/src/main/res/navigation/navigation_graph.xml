<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/friendListFragment">

    <!-- 검색 프래그먼트 -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.planalog.ui.search.SearchFragment"
        tools:layout="@layout/fragment_search">

        <!-- 액션: SearchFragment에서 FriendpageFragment로 이동 -->
        <action
            android:id="@+id/action_searchFragment_to_friendpageFragment"
            app:destination="@id/friendpageFragment" />
    </fragment>

    <!-- 친구 목록 프래그먼트 -->
    <fragment
        android:id="@+id/friendListFragment"
        android:name="com.example.planalog.ui.friends.FriendListFragment"
        tools:layout="@layout/fragment_friendlist">

        <!-- 액션: FriendListFragment에서 FriendpageFragment로 이동 -->
        <action
            android:id="@+id/action_friendListFragment_to_friendpageFragment"
            app:destination="@id/friendpageFragment" />
    </fragment>

    <!-- 친구 프로필 페이지 프래그먼트 -->
    <fragment
        android:id="@+id/friendpageFragment"
        android:name="com.example.planalog.ui.friends.FriendpageFragment"
        tools:layout="@layout/activity_friendpage">
        <!-- 전달할 번들 데이터 설정 -->
        <argument
            android:name="friendId"
            app:argType="integer" />
    </fragment>

</navigation>
