<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_2">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/commentRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 댓글 입력창 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:elevation="4dp"
        android:layout_margin="8dp">

        <EditText
            android:id="@+id/commentInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_light"
            android:layout_weight="1"
            android:hint="@string/enter"
            android:textColorHint="@color/search_hint_color"
            android:padding="12dp"
            android:background="@drawable/edittext_edge"
            android:text=""
            android:textColor="@color/main_1"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/commentPostButton"
            android:fontFamily="@font/pretendard_medium"
            android:textSize="14sp"
            android:layout_width="45dp"
            android:layout_height="28dp"
            android:text="@string/put"
            android:textColor="@color/main_1"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:background="@drawable/edge_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/commentInput"
            app:layout_constraintTop_toTopOf="@id/commentInput"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
